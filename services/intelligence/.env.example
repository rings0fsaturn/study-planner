SUPABASE_JWT_SECRET=<project JWT secret from Supabase dashboard -> Settings -> API>
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role key from Supabase dashboard -> Settings -> API>
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
GEMINI_API_KEY=<API-KEY>
EMBEDDING_PROVIDER=qwen-sidecar
EMBEDDER_URL=http://localhost:8200
RERANKER_URL=http://localhost:8200
INGESTION_BATCH_SIZE=100
INGESTION_MAX_BATCH_TOKENS=4000
INGESTION_MAX_TOKENS_PER_MINUTE=25000
OPENROUTER_API_KEY=<openrouter key>
GENERATION_MODEL=deepseek/deepseek-v4-flash-0731
GENERATION_BASE_URL=https://openrouter.ai/api/v1
GENERATION_TIMEOUT_MS=30000
GENERATION_MAX_OUTPUT_TOKENS=4096
GENERATION_TEMPERATURE=0.3
GENERATION_REASONING_EFFORT=off
# Code-execution sandbox for coding grading (#42, D-02 Piston fallback).
# Defaults match the loopback-published dev service; the Python runtime
# installs on first use into the piston-packages volume (docker-compose.yml).
PISTON_URL=http://127.0.0.1:2000
PISTON_PYTHON_VERSION=3.12.0
PISTON_HTTP_TIMEOUT_MS=60000
PISTON_MAX_CPU_TIME_MS=15000
PISTON_WALL_TIME_EXTRA_MS=1000
PISTON_MAX_MEMORY_MB=256
# Jev System One via OpenRouter (jev-integration): dedicated key isolates Jev
# spend; model is pinned (not jev-latest) so tuned thresholds stay stable.
OPENROUTER_JEV_API_KEY=<openrouter key for Jev>
JEV_MODEL=jev-1.13
JEV_BASE_URL=https://openrouter.ai/api
JEV_TIMEOUT_MS=30000
# Spend estimate rate ($/Mtok input; output is free): the SystemOne surface
# returns no usage.cost, so the probe estimates at the TypeSafe list price.
JEV_PRICE_PER_MTOK=0.042
# Slice-1 Jev gate (#70): one flag for the suitability pre-gate + citation
# middle-only adjudication. The slice-4 grading rubric shadow (#73) reuses
# this flag with a 15 s ceiling (fits the 30 s grading window). Off (default)
# means zero decide() calls.
JEV_SLICE1_ENABLED=false
# Slice-2 passage shadow ceiling (#72): tighter than JEV_TIMEOUT_MS so the one
# batched classify call fits the 90 s visibility window; starting point for #74.
# Keep JEV_SLICE2_MODEL/BASE_URL unset so both clients pin the same model.
JEV_SLICE2_TIMEOUT_MS=15000
# Slice-2 passage filter (#76 Phase B): when true, the batched passage verdicts
# decide the window generation sees - the declared keep-set, or the
# top-by-relevance floor (injection-flagged chunks skipped) when that leaves
# nothing. Independent of JEV_SLICE1_ENABLED; either flag builds the clients.
JEV_SLICE2_ENFORCE=false
