{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study-tracker.local/contracts/phase2/provider/generation-response.schema.json",
  "title": "NormalizedGenerationResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "model", "traceId", "outcome"],
  "properties": {
    "provider": { "const": "openrouter" },
    "model": { "type": "string", "minLength": 1 },
    "traceId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "providerRequestId": { "type": "string" },
    "content": { "type": "string" },
    "refusal": { "type": "string" },
    "structuredOutput": { "type": "object" },
    "finishReason": { "enum": ["stop", "length", "content_filter", "refusal", "error"] },
    "nativeFinishReason": { "type": "string" },
    "usage": { "type": "object", "additionalProperties": false, "required": ["promptTokens", "outputTokens", "totalTokens"], "properties": { "promptTokens": { "type": "integer", "minimum": 0 }, "outputTokens": { "type": "integer", "minimum": 0 }, "totalTokens": { "type": "integer", "minimum": 0 }, "reasoningTokens": { "type": "integer", "minimum": 0 } } },
    "routedProvider": { "type": "string" },
    "outcome": { "enum": ["ok", "partial", "safety_block", "quota_failure", "timeout", "malformed_output", "provider_error"] },
    "error": { "$ref": "../provider-error.schema.json" }
  },
  "allOf": [
    { "if": { "properties": { "outcome": { "const": "ok" } } }, "then": { "required": ["content"], "not": { "required": ["error"] } } },
    { "if": { "properties": { "outcome": { "const": "partial" } } }, "then": { "required": ["content"], "not": { "required": ["error"] } } },
    { "if": { "properties": { "outcome": { "enum": ["malformed_output", "quota_failure", "timeout", "provider_error", "safety_block"] } } }, "then": { "required": ["error"] } },
    { "if": { "properties": { "outcome": { "enum": ["quota_failure", "timeout"] } } }, "then": { "not": { "anyOf": [{ "required": ["content"] }, { "required": ["refusal"] }, { "required": ["finishReason"] }] } } }
  ]
}
