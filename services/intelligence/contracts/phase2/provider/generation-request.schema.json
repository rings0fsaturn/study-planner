{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study-tracker.local/contracts/phase2/provider/generation-request.schema.json",
  "title": "GenerationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "task", "model", "artifactIds", "traceId", "requestId", "correlationId", "promptTemplateVersion", "messages", "responseSchema"],
  "properties": {
    "provider": { "const": "openrouter" },
    "task": { "enum": ["assessment_generation", "written_grading", "guide_hint", "guide_reveal"] },
    "model": { "type": "string", "minLength": 1 },
    "artifactIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "ownerId": { "type": "string", "minLength": 1 },
    "traceId": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "promptTemplateVersion": { "type": "string", "pattern": "^v[0-9]+$" },
    "messages": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["role", "content"], "properties": { "role": { "enum": ["system", "user", "assistant"] }, "content": { "type": "string", "minLength": 1 } } } },
    "ragContext": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["chunkId", "materialId", "quote"], "properties": { "chunkId": { "type": "string" }, "materialId": { "type": "string" }, "quote": { "type": "string" }, "startSeconds": { "type": "number", "minimum": 0 } } } },
    "responseSchema": { "type": "object", "required": ["type", "properties"] },
    "temperature": { "const": 0.3 },
    "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 65536, "default": 4096 },
    "reasoningEffort": { "enum": ["off", "low", "medium", "high"], "default": "off" },
    "timeoutMs": { "type": "integer", "minimum": 1, "default": 30000 }
  }
}
