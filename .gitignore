node_modules/
# 9p/drvfs is ~100x slower to read; node_modules may be symlinked to the Linux
# fs (see .work/STATUS.md gotchas). A trailing slash only matches directories,
# so a symlinked node_modules would show as untracked and could be committed.
node_modules
dist/
.env
.env.local
.env.*.local
services/intelligence/.env
*.log
.DS_Store
.vite/
.svelte-kit/
.vercel/
.output/
.dev/
test-results/
playwright-report/
.claude/settings.local.json
# code-memory: agent-only index, do not commit
.claude/memory/

# transient agent worktrees
.claude/worktrees/
/handovers/

# Archives and transient scratch
*.zip
*.rar
/tmp/

# playwright-cli session snapshots and traces
.playwright-cli/

# pdf.js wasm decoders, copied into public/ by apps/app/scripts/sync-pdfjs-wasm.mjs
apps/app/public/pdfjs-wasm/

# Pyodide runtime, copied into public/ by apps/app/scripts/sync-pyodide-assets.mjs
apps/app/public/pyodide/

# Hermes agent workspace mirrors of the agents rules/skills (tool-generated)
.hermes/

# Python / uv
.venv/
.venv-bakeoff/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Supabase CLI local state
apps/app/supabase/.temp/
apps/app/supabase/.branches/
supabase/.temp/

# code-memory: agent-only index, do not commit
.codex/memory/

