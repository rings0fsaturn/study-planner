# Copy this file to the repository root as .env, fill in the values, then run:
#   ./docker-app start
#
# The web app is served at http://localhost:8080/ and the app at
# http://localhost:8080/study/. The Intelligence Service listens on
# http://localhost:8000/ and the browser reaches it through the same origin
# (VITE_INTELLIGENCE_URL=/api proxied by nginx).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Only needed when the Supabase project signs HS256 tokens. ES256/RS256
# projects verify through the public JWKS endpoint and can leave this empty.
SUPABASE_JWT_SECRET=
# Service-role key used by the ingestion worker only (API never sees it).
# Keep it in the runtime env file; it must never be committed.
SUPABASE_SERVICE_ROLE_KEY=
# Gemini API key for embeddings (gemini-embedding-001). Without it the
# extraction/chunking stages still run but embedding fails with a clear error.
GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_INTELLIGENCE_URL=/api
VITE_INITIAL_RESTORE_TIMEOUT_MS=8000
WEB_PORT=8080
INTELLIGENCE_PORT=8000
# Ingestion worker tuning (optional)
INGESTION_BATCH_SIZE=100
INGESTION_VISIBILITY_SECONDS=30
INGESTION_POLL_INTERVAL_SECONDS=1
INGESTION_MAX_DELIVERIES=3
INGESTION_MAX_IN_FLIGHT=1
INGESTION_MAX_BATCH_TOKENS=4000
INGESTION_MAX_TOKENS_PER_MINUTE=25000
# Sidecar ingestion (local GPU embedder, rule 54)
# Sweep winner 128 + HTTP 16 = 4,381 warm chunks/min (2026-08-17)
EMBEDDING_PROVIDER=qwen-sidecar
EMBEDDER_URL=http://host.docker.internal:8200
RERANKER_URL=http://host.docker.internal:8200
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=128
RERANKER_BATCH_SIZE=8
# Code-execution sandbox (#42, profile `sandbox`, demand-started)
# Piston (MIT) replaced Judge0 CE after the P2 isolate gate: Judge0's bundled
# isolate 1.8.1 is cgroup-v1-only and this WSL2/Docker Desktop host is
# cgroup-v2-only. No secrets; the Python runtime installs on first use into
# the piston-packages volume (see docker-compose.yml).
PISTON_URL=http://127.0.0.1:2000
