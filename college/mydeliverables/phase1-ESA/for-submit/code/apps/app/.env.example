SUPABASE_URL=https://<project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon-key>
VITE_INTELLIGENCE_URL=http://localhost:8000
# Optional: override the cold-start cloud-restore safety timeout in milliseconds.
# VITE_INITIAL_RESTORE_TIMEOUT_MS=8000

# Service-side only: the Intelligence Service also requires SUPABASE_JWT_SECRET.
# It also uses SUPABASE_URL for Supabase JWKS verification when tokens are ES256/RS256.
# Set service secrets in services/intelligence/.env or the service shell, never in apps/app/.env.local.
